        "\n",
        "def calculate_weinstein(close_series):\n",
        "    if len(close_series) < SMA_LEN_WEEKLY + SLOPE_LOOKBACK: return None, None, None, None\n",
        "    sma_w = close_series.rolling(SMA_LEN_WEEKLY).mean()\n",
        "    slope = (sma_w / sma_w.shift(SLOPE_LOOKBACK) - 1) * 100\n",
